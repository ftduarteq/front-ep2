{
    "family": "tienda-frontend-task",
    "networkMode": "awsvpc",
    "executionRoleArn": "arn:aws:iam::723000832551:role/LabRole",
    "taskRoleArn": "arn:aws:iam::723000832551:role/LabRole",
    "containerDefinitions": [
        {
            "name": "tienda-frontend",
            "image": "723000832551.dkr.ecr.us-east-1.amazonaws.com/tienda-frontend:latest",
            "essential": true,
            "portMappings": [
                {
                    "containerPort": 8080,
                    "hostPort": 8080,
                    "protocol": "tcp"
                }
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/tienda-frontend",
                    "awslogs-create-group": "true",
                    "awslogs-region": "us-east-1",
                    "awslogs-stream-prefix": "ecs"
                }
            }
        }
    ],
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "256",
    "memory": "512"
}
